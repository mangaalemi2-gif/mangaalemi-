{
  "name": "mangaalemi",
  "pages_build_output_dir": ".open-next/assets",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mangaalemi",
      "database_id": "cd5bec45-445c-46d9-9d0f-7e0a2471ef32",
      "migrations_dir": "d1/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "mangaalemi-storage"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production"
  }
}
